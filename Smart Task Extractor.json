    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a task extraction assistant.\n\nToday’s date is {{ $now.toISO().slice(0,10) }}.\n\nAnalyze the following message and determine if it contains a task or reminder.\n\nMessage:\n\"{{$json.raw_message}}\"\n\nIf it is a task, extract and return ONLY valid JSON in this format:\n{\n  \"is_task\": true,\n  \"task_title\": \"\",\n  \"due_date\": \"\",\n  \"due_time\": \"\",\n  \"priority\": \"\"\n}\n\nRules:\n- due_date must be in YYYY-MM-DD format\n- Resolve relative dates like \"today\", \"tomorrow\", \"next Monday\" using today’s date\n- due_time must be in HH:MM (24-hour format) or null if not mentioned\n- priority must be one of: High, Medium, Low\n\nIf the message is NOT a task, return ONLY:\n{\n  \"is_task\": false\n}\n\nDo not include explanations, markdown, or extra text.\nReturn JSON only.\n",
        "options": {}
      },
